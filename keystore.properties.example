# Kopieren nach "keystore.properties" (bleibt via .gitignore lokal) und mit den
# echten Werten deines Release-Keystores befüllen. Erzeugen z. B. mit:
#   keytool -genkeypair -v -keystore sitecar-release.keystore -alias sitecar \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Ohne diese Datei bauen assembleRelease/bundleRelease weiterhin, nur unsigniert.

storeFile=/absolute/pfad/zu/sitecar-release.keystore
storePassword=changeit
keyAlias=sitecar
keyPassword=changeit
