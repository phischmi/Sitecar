<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nur für lokale Erinnerungen an erkannte Fristen (Feature "Intelligente Vorschläge"). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Bezahlfunktion vorerst deaktiviert (siehe Features.SUPPORTER_ENABLED): die
      Play-Billing-Library mischt sonst automatisch die BILLING-Permission ein.
      Zum Reaktivieren diesen Block entfernen und Features.SUPPORTER_ENABLED = true.
    -->
    <uses-permission
        android:name="com.android.vending.BILLING"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <application
        android:name=".SitecarApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sitecar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Sitecar" />

        <!--
          "Teilen an Sitecar": empfängt Bilder und PDFs aus anderen Apps
          (z. B. Mail-Anhänge, Galerie-Fotos, Chat-Bilder) und schickt sie in
          denselben Upload-Screen wie ein Kamera-Scan. Bewusst auf image/*,
          application/pdf und application/octet-stream (manche Apps deklarieren
          PDFs darüber, z. B. wenn ihr FileProvider keinen expliziten Typ
          zuordnet) beschränkt, damit die App im Share-Sheet nicht für beliebige
          Inhalte auftaucht.

          Opt-in: eigener activity-alias statt Intent-Filter direkt auf
          .MainActivity, damit sich die Sichtbarkeit im Share-Sheet zur
          Laufzeit per PackageManager.setComponentEnabledSetting() an-/abschalten
          lässt (siehe ShareReceiver.kt, SettingsStore.shareIntentEnabled) —
          Standard ist deaktiviert.
        -->
        <activity-alias
            android:name=".ShareReceiver"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity-alias>

        <!--
          Launcher-Icon-Varianten (eine pro Akzentfarbe, siehe LauncherIcon.kt).
          Nur eine Alias ist zur gleichen Zeit enabled; das MAIN/LAUNCHER
          intent-filter liegt bewusst hier statt direkt auf .MainActivity,
          sonst gäbe es zusätzlich zum Alias-Icon ein zweites, statisches
          App-Icon im Launcher.
        -->
        <activity-alias
            android:name=".LauncherIndigo"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherEmerald"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_emerald"
            android:roundIcon="@mipmap/ic_launcher_emerald_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherAmber"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amber"
            android:roundIcon="@mipmap/ic_launcher_amber_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherRose"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rose"
            android:roundIcon="@mipmap/ic_launcher_rose_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          "Papra"-Akzent: reproduziert Papras eigenes Neon-Lime (Dunkelmodus-
          Farbe, siehe Theme.kt/AccentColor.PAPRA) als Icon-Hintergrund — beim
          Icon wird bewusst immer die Dunkelmodus-Akzentfarbe verwendet.
        -->
        <activity-alias
            android:name=".LauncherPapra"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_papra"
            android:roundIcon="@mipmap/ic_launcher_papra_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
