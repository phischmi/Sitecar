    <string name="settings_ocr_title">On-device text recognition (OCR)</string>
    <string name="settings_ocr_subtitle">Embeds a searchable text layer into the PDF before upload. Turn off if your Papra server already runs OCR (e.g. Mistral OCR).</string>

    <string name="settings_share_intent_title">Share to Sitecar</string>
    <string name="settings_share_intent_subtitle">Let other apps share images and PDFs directly to Sitecar via Android\'s share sheet.</string>

    <string name="settings_smart_insights_title">Smart suggestions</string>
    <string name="settings_smart_insights_subtitle">Suggests tags, the document\'s own date, and the detected sender from the scanned text — all on-device, rule-based.</string>

    <string name="settings_on_device_ai_title">On-device AI (Gemini Nano)</string>
    <string name="settings_on_device_ai_subtitle">Improves smart suggestions using Gemini Nano via Android AICore — fully on-device, no data leaves the phone. Requires a compatible device and a one-time model download; falls back to the rule-based suggestions above if unavailable.</string>
    <string name="settings_on_device_ai_unavailable">This device does not support Gemini Nano. Smart suggestions keep using the rule-based analysis.</string>
    <string name="settings_on_device_ai_download_failed">Model download failed. Please check your connection and try again.</string>
    <string name="settings_on_device_ai_checking">Checking availability…</string>
    <string name="settings_on_device_ai_download_background">The download keeps running in the background — you can leave this screen, the switch turns on by itself once the model is ready.</string>
    <string name="settings_smart_insights_ocr_note">For scans without a text layer, both also require on-device text recognition (OCR, see above) to be turned on.</string>

