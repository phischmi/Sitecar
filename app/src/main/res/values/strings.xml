<resources>
    <string name="app_name">Sitecar</string>

    <string name="onboarding_welcome_title">Welcome to Sitecar</string>
    <string name="onboarding_welcome_body">Sitecar scans your documents with the phone camera and uploads them straight to your own Papra server — no detour through someone else\'s cloud.</string>
    <string name="onboarding_welcome_tour">Show a short tour of the features afterwards</string>
    <string name="onboarding_welcome_start">Get started</string>
    <string name="onboarding_connect_title">Connect your Papra server</string>
    <string name="onboarding_connect_body">Enter the address of your Papra instance and an API key. You create the key in Papra under \"API keys\".</string>
    <string name="onboarding_continue">Continue</string>
    <string name="onboarding_back">Back</string>
    <string name="onboarding_finish">Done</string>
    <string name="onboarding_tour_scan_title">Scan documents</string>
    <string name="onboarding_tour_scan_body">The camera finds the page edges by itself and turns several pages into a single PDF. On-device text recognition puts a searchable layer underneath.</string>
    <string name="onboarding_tour_upload_title">Upload and name</string>
    <string name="onboarding_tour_upload_body">Pick the organization, set tags, and let the file name build itself from your template. Other apps can share images and PDFs straight into Sitecar.</string>
    <string name="onboarding_tour_insights_title">Smart suggestions</string>
    <string name="onboarding_tour_insights_body">Sitecar reads the scanned text on your device and suggests tags, the document\'s own date and its sender — optionally with Gemini Nano.</string>
    <string name="onboarding_tour_manage_title">Keep things in order</string>
    <string name="onboarding_tour_manage_body">Search documents, edit tags, open details, restore from the trash — and put the action you use most on a swipe gesture in the settings.</string>

